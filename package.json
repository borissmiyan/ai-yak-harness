{
  "name": "ai-yak-harness",
  "version": "1.0.0",
  "description": "Universal AI Engineering Harness Starter Kit — Deterministic verification, anti-tampering, resource hygiene, AST linting, and 8-tier safety gates for autonomous AI agents.",
  "type": "module",
  "bin": {
    "ai-yak-harness": "./setup.mjs"
  },
  "scripts": {
    "setup": "node setup.mjs",
    "check:design": "node scripts/verify-design-system.mjs",
    "check:design:fix": "node scripts/verify-design-system.mjs --fix",
    "design:export-tokens": "node scripts/export-design-tokens.mjs",
    "design:scaffold-ui": "node scripts/scaffold-ui-kit.mjs",
    "design:showcase": "node scripts/generate-design-showcase.mjs",
    "check:security:antipatterns": "node scripts/verify-security-antipatterns.mjs",
    "check:debug-leftovers": "node scripts/verify-no-debug-leftovers.mjs",
    "check:large-files": "node scripts/verify-no-large-files.mjs",
    "audit": "bash skills/codebase-audit/scripts/audit_cycle.sh .",
    "audit:ci": "bash skills/codebase-audit/scripts/audit_cycle.sh . --ci --fail-on=CRITICAL",
    "audit:fix": "bash skills/codebase-audit/scripts/audit_cycle.sh . --fix"
  },
  "keywords": [
    "ai-agent",
    "harness",
    "quality-gate",
    "anti-tampering",
    "diff-budget",
    "vitest",
    "playwright",
    "stryker",
    "cursor",
    "claude-code",
    "antigravity"
  ],
  "author": "Boris Smiyan <borissmiyan@gmail.com>",
  "license": "SEE LICENSE IN LICENSE"
}
